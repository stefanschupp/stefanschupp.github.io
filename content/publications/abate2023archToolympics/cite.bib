  author    = {Abate, Alessandro and Althoff, Matthias and Bu, Lei and Ernst, Gidon and Frehse, Goran and Geretti, Luca and Johnson, Taylor T and Menghi, Claudio and Mitsch, Stefan and Schupp, Stefan and others},
  booktitle = {International TOOLympics Challenge},
