@InProceedings{leofante2019engineering,
  author    = {Leofante, Francesco and Schupp, Stefan and Ábrahám, Erika and Tacchella, Armando},
  booktitle = {ECMS},
  title     = {Engineering Controllers for Swarm Robotics Via Reachability Analysis in Hybrid Systems.},
  pages     = {407--413},
  year      = {2019},
  doi       = {10.7148/2019-0407},
  abstract = {In this paper we propose hybrid systems and reachability analysis to verify properties in swarm robotics systems, i.e., teams of robots performing cooperative tasks without any centralized coordination. We discuss the challenges that are to be faced and we report on the experience gained from applying hybrid formalisms to the verification of swarm robotics systems.},
}
